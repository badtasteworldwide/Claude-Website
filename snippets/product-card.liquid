{% comment %} Renders a product card. Accepts: card_product {% endcomment %}
{%- liquid
  assign cp = card_product
  assign on_sale = false
  if cp.compare_at_price > cp.price
    assign on_sale = true
    assign save_amount = cp.compare_at_price | minus: cp.price | money_without_trailing_zeros
  endif
  comment
    The type label above the name already says "License Plate Frame", so the card
    drops that tail from the name to keep phone cards to two lines. Full title stays in alt text.
  endcomment
  assign short_name = cp.title | remove: ' License Plate Frame' | remove: ' license plate frame' | remove: ' License plate frame'
  if short_name == blank
    assign short_name = cp.title
  endif
-%}
<article class="product-card">
  <a href="{{ cp.url }}" class="product-card__image" style="background: linear-gradient(135deg, var(--pink), var(--pink-deep));">
    <div class="product-card__badges">
      {%- unless cp.available -%}
        <span class="badge badge--red">SOLD OUT</span>
      {%- endunless -%}
      {%- if on_sale -%}
        <span class="badge badge--yellow">SAVE {{ save_amount }}</span>
      {%- endif -%}
      {%- for tag in cp.tags -%}
        {%- if tag contains 'badge:' -%}
          <span class="badge badge--pink">{{ tag | remove: 'badge:' | strip | upcase }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if cp.featured_image -%}
      <img class="product-card__photo"
           src="{{ cp.featured_image | image_url: width: 600 }}"
           srcset="{{ cp.featured_image | image_url: width: 400 }} 400w, {{ cp.featured_image | image_url: width: 600 }} 600w, {{ cp.featured_image | image_url: width: 900 }} 900w"
           sizes="(max-width: 960px) 62vw, 25vw"
           alt="{{ cp.featured_image.alt | default: cp.title | escape }}" loading="lazy" width="600" height="450">
    {%- else -%}
      <div class="product-card__mini-plate">
        {%- render 'plate',
          top: cp.metafields.custom.frame_top,
          bottom: cp.metafields.custom.frame_bottom,
          number: cp.metafields.custom.plate_number,
          color1: cp.metafields.custom.plate_color_1,
          color2: cp.metafields.custom.plate_color_2 -%}
      </div>
    {%- endif -%}
    {%- if cp.available and cp.variants.size == 1 and cp.selected_or_first_available_variant -%}
      <button type="button" class="btn btn--sm btn--ink product-card__quickadd" data-quick-add="{{ cp.selected_or_first_available_variant.id }}">+ Quick Add · {{ cp.price | money }}</button>
    {%- elsif cp.available -%}
      <span class="btn btn--sm btn--ink product-card__quickadd">Choose Options →</span>
    {%- endif -%}
  </a>
  <div class="product-card__info">
    {%- if cp.type != blank -%}<div class="product-card__theme">{{ cp.type }}</div>{%- endif -%}
    <a href="{{ cp.url }}" class="product-card__link"><span class="product-card__name">{{ short_name }}</span></a>
    <div class="product-card__price-row">
      <span class="product-card__price">{{ cp.price | money }}</span>
      {%- if on_sale -%}<span class="product-card__compare">{{ cp.compare_at_price | money }}</span>{%- endif -%}
    </div>
  </div>
</article>
