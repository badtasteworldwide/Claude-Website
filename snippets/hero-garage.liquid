{%- comment -%}
  Compact Plate Frame Garage for the hero card: same markup, data and script as
  sections/plate-frame-garage.liquid, with the design rail hidden. Visitors step
  through designs with the dock arrows; "All designs" opens the full garage page.
{%- endcomment -%}
{{ 'plate-frame-garage.css' | asset_url | stylesheet_tag }}
<div
  class="pfg pfg--dark pfg--hero"
  data-pfg
  data-catalog="{{ 'pfg-catalog.json' | file_url }}"
  data-thumbs="{{ 'pfg-thumbs.webp' | file_url }}"
  data-model="{{ 'pfg-frame.glb' | file_url }}"
  data-sheet="{{ 'pfg-sheet-00.webp' | file_url }}"
  data-products="{{ routes.root_url | append: '/products/' | replace: '//', '/' }}"
>
  {%- comment -%} Hidden, but mount() expects these controls to exist. {%- endcomment -%}
  <aside class="pfg-rail" hidden>
    <input type="search" data-role="q" aria-hidden="true" tabindex="-1">
    <button type="button" data-filter="current" aria-pressed="true" tabindex="-1"><span data-count="current"></span></button>
    <button type="button" data-filter="all" aria-pressed="false" tabindex="-1"><span data-count="all"></span></button>
    <nav data-role="list"></nav>
  </aside>

  <div class="pfg-bay">
    <canvas data-role="stage" aria-label="3D preview of the selected plate frame. Drag to rotate, scroll or pinch to zoom."></canvas>
    <div class="pfg-loading" data-role="loading">Loading 3D preview…</div>
    <a class="pfg-hero-all" href="{{ all_designs_url | default: '/pages/plate-frames' }}">All designs <span aria-hidden="true">→</span></a>
    <div class="pfg-plaque" aria-live="polite">
      <span class="pfg-eyebrow" data-role="eyebrow"></span>
      <h3 data-role="name"></h3>
      <a class="pfg-shop" data-role="shop" href="#" hidden>Shop this frame <span aria-hidden="true">→</span></a>
    </div>
    <p class="pfg-credit" data-role="credit" hidden>Car: “Car Concept” by Eric Chadwick / Darmstadt Graphics Group, <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>, modified (logos removed, simplified)</p>
    <div class="pfg-dock" role="toolbar" aria-label="Viewer controls">
      <button type="button" class="pfg-btn pfg-icon" data-role="prev" aria-label="Previous design"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
      <button type="button" class="pfg-btn" data-role="plate" aria-pressed="true">Plate</button>
      <button type="button" class="pfg-btn" data-role="car" aria-pressed="false" title="Show the frame mounted on a car">Car</button>
      <button type="button" class="pfg-btn" data-role="spin" aria-pressed="false">Spin</button>
      <button type="button" class="pfg-btn" data-role="reset">Reset</button>
      <button type="button" class="pfg-btn pfg-icon" data-role="next" aria-label="Next design"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
    </div>
  </div>
</div>
{%- comment -%}
  Loader instead of a plain module tag: desktop mounts the viewer right away (as before);
  phones only fetch the viewer and three.js when the shopper opens it (BTWloadGarage).
{%- endcomment -%}
<script>
  (function () {
    var src = {{ 'plate-frame-garage.js' | asset_url | json }};
    var loaded = false;
    function load() {
      if (loaded) return;
      loaded = true;
      import(src).catch(function (e) { console.error(e); });
    }
    window.BTWloadGarage = load;
    var mq = window.matchMedia('(min-width: 961px)');
    if (mq.matches) load();
    else if (mq.addEventListener) mq.addEventListener('change', function (e) { if (e.matches) load(); });
  })();
</script>
<style>
  /* Hero card skin: the garage's own CSS stays untouched; these rules only
     re-dress the compact .pfg--hero copy in the theme's print-shop language. */
  .hero__visual--3d { background: var(--ink); }
  .pfg--hero { position: absolute; inset: 0; display: block; height: auto; border: 0; border-radius: 0;
    --pfg-accent: var(--pink); --pfg-panel: #111111; --pfg-bg: #1d1d1d; --pfg-bay: #111111; --pfg-bay-glow: #2a2a2a; --pfg-line: #ffffff; --pfg-fg: #ffffff; --pfg-muted: #c9bfc5; }
  .pfg--hero .pfg-rail { display: none; }
  .pfg--hero .pfg-bay { position: absolute; inset: 0; height: auto; }
  .pfg-hero-all {
    position: absolute; top: 14px; right: 14px; z-index: 2;
    font: 800 11px/1 var(--font-label); text-transform: uppercase; letter-spacing: .02em;
    color: var(--ink); background: var(--yellow); border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--pink);
    padding: 10px 12px; min-height: 40px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;
  }
  .pfg-hero-all:hover { background: var(--paper); text-decoration: none; }
  .pfg-hero-all:focus-visible { outline: 3px solid var(--yellow); outline-offset: 3px; }
  .pfg--hero .pfg-plaque { left: 20px; top: 18px; right: 160px; gap: 8px; }
  .pfg--hero .pfg-eyebrow { color: var(--pink-soft); font-family: var(--font-label); font-weight: 800; letter-spacing: .02em; }
  .pfg--hero .pfg-plaque h3 { font-family: var(--font-display); font-weight: 400; font-size: clamp(22px, 2.4vw, 32px); line-height: 1.06; }
  .pfg--hero .pfg-shop {
    border-radius: 0; background: var(--pink); color: var(--ink) !important; border: 2px solid var(--paper);
    font-family: var(--font-display); font-weight: 400; font-size: 13px; text-transform: uppercase; letter-spacing: .02em;
    padding: 10px 14px; min-height: 40px; display: inline-flex; align-items: center; gap: 6px; box-shadow: 3px 3px 0 var(--paper); white-space: nowrap;
  }
  .pfg--hero .pfg-shop:hover { filter: none; background: var(--yellow); }
  .pfg--hero .pfg-loading { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; font-size: 12px; padding: 0 24px; text-align: center; }
  .pfg--hero .pfg-dock {
    border-radius: 0; background: var(--ink); border: 2px solid var(--paper); backdrop-filter: none; padding: 4px; gap: 4px;
    box-shadow: 4px 4px 0 var(--pink);
  }
  .pfg--hero .pfg-btn {
    border-radius: 0; min-height: 40px; color: var(--paper);
    font-family: var(--font-label); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: .02em;
  }
  .pfg--hero .pfg-btn:hover { background: #2a2a2a; }
  .pfg--hero .pfg-btn[aria-pressed="true"] { background: var(--yellow); color: var(--ink); }
  .pfg--hero :focus-visible { outline: 3px solid var(--yellow); outline-offset: 2px; }
  .pfg--hero .pfg-credit { bottom: 84px; color: var(--pfg-muted); }
  @media (max-width: 820px) {
    .pfg--hero .pfg-bay { height: auto; order: 0; }
    .pfg--hero .pfg-plaque { left: 14px; top: 14px; right: 140px; }
    .pfg--hero .pfg-dock { left: 10px; right: 10px; justify-content: space-between; gap: 2px; }
    .pfg--hero .pfg-btn { padding: 8px 8px; font-size: 11px; }
    .pfg--hero .pfg-icon { padding: 8px 6px; }
    .pfg--hero .pfg-credit { bottom: 72px; }
  }
</style>
