<section class="reviews" id="reviews">
  <div class="section__head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="section__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section__title">{{ section.settings.heading }}</h2>
    </div>
  </div>
  {%- assign has_stats = false -%}
  {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}{%- assign has_stats = true -%}{%- endif -%}{%- endfor -%}
  {%- if has_stats -%}
    <div class="reviews__stat-row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="reviews__stat" {{ block.shopify_attributes }}>
            {%- if block.settings.show_stars -%}<span class="stars-big">★★★★★</span>{%- else -%}<strong>{{ block.settings.value }}</strong>{%- endif -%}
            <span>{{ block.settings.label }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  <div class="reviews__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'review' -%}
        <figure class="review-card" {{ block.shopify_attributes }}>
          <div class="review-card__stars stars-row">{% for i in (1..block.settings.stars) %}★{% endfor %}{% assign empty_stars = 5 | minus: block.settings.stars %}{% for i in (1..empty_stars) %}{% unless empty_stars == 0 %}☆{% endunless %}{% endfor %}</div>
          <div class="review-card__title">{{ block.settings.title }}</div>
          <blockquote class="review-card__body">{{ block.settings.body }}</blockquote>
          <figcaption class="review-card__meta">
            <strong>{{ block.settings.name }}</strong>
            <span>{{ block.settings.product_name }}{% if block.settings.verified %} · ✔ Verified{% endif %}</span>
          </figcaption>
        </figure>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Receipts" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>People with taste <em>talk about us.</em></p>" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "checkbox", "id": "show_stars", "label": "Show stars instead of value", "default": false },
        { "type": "text", "id": "value", "label": "Value", "default": "3,300+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Orders shipped" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Review title" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Paste a real customer review here." },
        { "type": "text", "id": "name", "label": "Reviewer", "default": "Customer name" },
        { "type": "text", "id": "product_name", "label": "Product name", "default": "Product" },
        { "type": "checkbox", "id": "verified", "label": "Verified badge", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "stat", "settings": { "value": "3,300+", "label": "Orders shipped" } },
        { "type": "stat", "settings": { "value": "4,500+", "label": "Items sold" } },
        { "type": "stat", "settings": { "value": "160", "label": "Frame designs" } }
      ]
    }
  ]
}
{% endschema %}
