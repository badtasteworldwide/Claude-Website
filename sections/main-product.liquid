{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign has_frame_3d = false -%}
{%- if product.handle contains 'plate-frame' -%}{%- assign has_frame_3d = true -%}{%- endif -%}
<div class="pdp" data-pdp>
  <div class="pdp__grid">
    <div class="pdp__media">
      {%- liquid
        assign media_ar = 1
        if product.featured_image
          assign media_ar = product.featured_image.aspect_ratio | at_least: 1 | at_most: 2
        endif
      -%}
      <div class="pdp__main-img" style="--media-ar: {{ media_ar }};" data-pdp-main>
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 1000 }}"
               srcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 1000 }} 1000w, {{ product.featured_image | image_url: width: 1400 }} 1400w"
               sizes="(max-width: 960px) 100vw, 50vw"
               alt="{{ product.featured_image.alt | default: product.title | escape }}"
               width="1000" height="{{ 1000 | divided_by: product.featured_image.aspect_ratio | round }}" fetchpriority="high">
        {%- else -%}
          <div style="width: 80%;">
            {%- render 'plate',
              top: product.metafields.custom.frame_top,
              bottom: product.metafields.custom.frame_bottom,
              number: product.metafields.custom.plate_number,
              color1: product.metafields.custom.plate_color_1,
              color2: product.metafields.custom.plate_color_2 -%}
          </div>
        {%- endif -%}
        {%- if has_frame_3d -%}
          {%- comment -%} 3D slide, filled in by plate-frame-garage.js when this product has a design in Content > Files > pfg-catalog.json. {%- endcomment -%}
          <div class="pfg3d" data-pfg-pdp hidden
            data-handle="{{ product.handle }}"
            data-catalog="{{ 'pfg-catalog.json' | file_url }}"
            data-thumbs="{{ 'pfg-thumbs.webp' | file_url }}"
            data-model="{{ 'pfg-frame.glb' | file_url }}"
            data-sheet="{{ 'pfg-sheet-00.webp' | file_url }}">
            <canvas aria-label="3D preview of this frame. Drag to rotate."></canvas>
            <span class="pfg3d__loading">Loading 3D…</span>
            <span class="pfg3d__hint">3D · Drag to rotate</span>
            <div class="pfg3d__designs" data-role="designs" role="group" aria-label="Designs" hidden></div>
            <button type="button" class="pfg3d__car" data-role="car" aria-pressed="false" hidden>On a car</button>
            <p class="pfg3d__credit" data-role="credit" hidden>Car: “Car Concept” by Eric Chadwick / Darmstadt Graphics Group, <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>, modified (logos removed, simplified)</p>
          </div>
          <button type="button" class="pdp__3d-btn" data-pdp-3d hidden
            data-css="{{ 'plate-frame-garage.css' | asset_url }}"
            data-js="{{ 'plate-frame-garage.js' | asset_url }}">Spin it in 3D</button>
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 or has_frame_3d and product.images.size > 0 -%}
        <div class="pdp__thumbs"{% if product.images.size < 2 %} style="display: none;"{% endif %}>
          {%- for image in product.images limit: 8 -%}
            <button type="button" class="pdp__thumb" data-src="{{ image | image_url: width: 1000 }}" data-active="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 200 }}" alt="" loading="lazy" width="200" height="{{ 200 | divided_by: image.aspect_ratio | round }}">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp__info">
      <div class="pdp__vendor">
        {%- if product.type != blank -%}{{ product.type }}{%- else -%}{{ product.vendor }}{%- endif -%}
      </div>
      <h1 class="pdp__title">{{ product.title }}</h1>

      <div class="pdp__price-row">
        <span class="pdp__price" data-price>{{ current_variant.price | money }}</span>
        <span class="pdp__compare" data-compare-price {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
          {%- if current_variant.compare_at_price > current_variant.price -%}{{ current_variant.compare_at_price | money }}{%- endif -%}
        </span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="badge badge--yellow pdp__badge-save">SAVE {{ current_variant.compare_at_price | minus: current_variant.price | money_without_trailing_zeros }}</span>
        {%- endif -%}
      </div>

      {%- form 'product', product, data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          <div data-variant-picker>
            {%- for option in product.options_with_values -%}
              <div class="option-row">
                <div class="option-label">{{ option.name }}</div>
                <div class="option-pills">
                  {%- for value in option.values -%}
                    <label class="option-pill">
                      <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}>
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <div class="qty-row">
          <span class="option-label">Quantity</span>
          <div class="qty-stepper">
            <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="Quantity">
            <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
          </div>
          {%- if current_variant.inventory_management and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.low_stock_threshold -%}
            <span class="product-card__stock">Only {{ current_variant.inventory_quantity }} left</span>
          {%- endif -%}
        </div>

        <div class="pdp__atc-row" data-pdp-atc>
          {%- if current_variant.available -%}
            <button type="submit" class="btn btn--lg btn--full" data-label="Add To Cart →">Add To Cart →</button>
          {%- else -%}
            <button type="submit" class="btn btn--lg btn--full" disabled>Sold Out</button>
          {%- endif -%}
        </div>
      {%- endform -%}

      {%- if section.settings.trust_text != blank -%}
        <div class="pdp__trust">{{ section.settings.trust_text }}</div>
      {%- endif -%}

      <div class="pdp__desc rte">{{ product.description }}</div>

      {%- if section.settings.show_faq_accordion -%}
        <div class="faq__list" style="margin-top: 24px;">
          {%- for block in section.blocks -%}
            <details class="faq__item" {{ block.shopify_attributes }}>
              <summary class="faq__q">{{ block.settings.question }}<span class="faq__toggle" aria-hidden="true">+</span></summary>
              <div class="faq__a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-variants-json>
    {{ product.variants | json }}
  </script>

  {%- comment -%} Sticky add to cart: slides in once the real button scrolls away; it submits the real form. {%- endcomment -%}
  <div class="pdp-sticky" data-pdp-sticky aria-hidden="true">
    <button type="button" class="pdp-sticky__cart" data-open-cart tabindex="-1" aria-label="Open cart">
      <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false"><path fill="currentColor" d="M243.86,197.65l-14.25-120A20.06,20.06,0,0,0,209.67,60H179.83A52,52,0,0,0,76.17,60H46.33A20.06,20.06,0,0,0,26.39,77.65l-14.25,120A20,20,0,0,0,32.08,220H223.92a20,20,0,0,0,19.94-22.35ZM128,36a28,28,0,0,1,27.71,24H100.29A28,28,0,0,1,128,36ZM36.5,196,49.81,84H76v20a12,12,0,0,0,24,0V84h56v20a12,12,0,0,0,24,0V84h26.19L219.5,196Z"/></svg>
      <b data-cart-count>{{ cart.item_count }}</b>
    </button>
    <div class="pdp-sticky__info">
      <span class="pdp-sticky__variant" data-sticky-variant>{% unless product.has_only_default_variant %}{{ current_variant.title }}{% endunless %}</span>
      <span class="pdp-sticky__price" data-sticky-price>{{ current_variant.price | money }}</span>
    </div>
    <button type="button" class="btn pdp-sticky__btn" data-sticky-add tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add To Cart{% else %}Sold Out{% endif %}</button>
  </div>
</div>

<script>
  (function () {
    var pdp = document.querySelector('[data-pdp]');
    if (!pdp) return;
    var form = pdp.querySelector('form[data-product-form]');
    var realBtn = form && form.querySelector('[type="submit"]');
    var bar = pdp.querySelector('[data-pdp-sticky]');
    var stickyBtn = bar.querySelector('[data-sticky-add]');
    var priceEl = pdp.querySelector('[data-price]');
    var stickyPrice = bar.querySelector('[data-sticky-price]');
    var stickyVariant = bar.querySelector('[data-sticky-variant]');

    /* Sticky bar: visible while the real add-to-cart row is off screen (below or above). */
    var atc = pdp.querySelector('[data-pdp-atc]');
    function setShown(on) {
      bar.dataset.visible = String(on);
      bar.setAttribute('aria-hidden', String(!on));
      Array.prototype.forEach.call(bar.querySelectorAll('button'), function (b) { b.tabIndex = on ? 0 : -1; });
      document.body.classList.toggle('pdp-sticky-on', on);
    }
    if (atc && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        var e = entries[0];
        // Only after the shopper has scrolled past it, not before they reach it.
        setShown(!e.isIntersecting && e.boundingClientRect.top < 0);
      }).observe(atc);
    }
    stickyBtn.addEventListener('click', function () {
      if (!form || stickyBtn.disabled) return;
      if (form.requestSubmit) form.requestSubmit(realBtn); else realBtn.click();
    });
    /* Mirror price, variant and button state from the real form. */
    function sync() {
      if (priceEl) stickyPrice.textContent = priceEl.textContent;
      var picked = Array.prototype.map.call(pdp.querySelectorAll('[data-variant-picker] input:checked'), function (i) { return i.value; });
      if (picked.length) stickyVariant.textContent = picked.join(' / ');
      if (realBtn) {
        stickyBtn.disabled = realBtn.disabled;
        var t = realBtn.textContent.trim();
        stickyBtn.textContent = /adding/i.test(t) ? 'Adding…' : (realBtn.disabled ? (t.replace(/\s*→\s*$/, '') || 'Sold Out') : 'Add To Cart');
      }
    }
    if (priceEl) new MutationObserver(sync).observe(priceEl, { childList: true, characterData: true, subtree: true });
    if (realBtn) new MutationObserver(sync).observe(realBtn, { childList: true, attributes: true, attributeFilter: ['disabled'], characterData: true, subtree: true });
    pdp.addEventListener('change', function () { setTimeout(sync, 0); });

    /* Swipe the main photo to step through the thumbnails. */
    var main = pdp.querySelector('[data-pdp-main]');
    var x0 = null, y0 = null;
    main.addEventListener('touchstart', function (e) { if (e.target.closest('.pfg3d')) return; x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    main.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0; x0 = null;
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
      var thumbs = Array.prototype.slice.call(pdp.querySelectorAll('.pdp__thumb'));
      if (thumbs.length < 2) return;
      var i = thumbs.findIndex(function (t) { return t.dataset.active === 'true'; });
      var next = thumbs[(Math.max(i, 0) + (dx < 0 ? 1 : -1) + thumbs.length) % thumbs.length];
      next.click();
      next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }, { passive: true });

    /* 3D on demand: show the button only if this product has a 3D design, and fetch
       the viewer (three.js, ~600 KB) only when it is tapped. */
    var btn3d = pdp.querySelector('[data-pdp-3d]');
    var root3d = pdp.querySelector('[data-pfg-pdp]');
    if (btn3d && root3d) {
      var check = function () {
        fetch(root3d.dataset.catalog).then(function (r) { return r.json(); }).then(function (cat) {
          var has = (cat.groups || []).some(function (g) { return (g.designs || []).some(function (d) { return d.product === root3d.dataset.handle; }); });
          if (has) btn3d.hidden = false;
        }).catch(function () {});
      };
      if ('requestIdleCallback' in window) requestIdleCallback(check, { timeout: 3000 }); else setTimeout(check, 1500);
      btn3d.addEventListener('click', function () {
        btn3d.disabled = true; btn3d.textContent = 'Loading 3D…';
        var css = document.createElement('link'); css.rel = 'stylesheet'; css.href = btn3d.dataset.css;
        document.head.appendChild(css);
        var js = document.createElement('script'); js.type = 'module'; js.src = btn3d.dataset.js;
        document.body.appendChild(js);
        var t = setInterval(function () { if (!root3d.hidden) { clearInterval(t); btn3d.hidden = true; } }, 200);
        setTimeout(function () { clearInterval(t); if (root3d.hidden) { btn3d.disabled = false; btn3d.textContent = 'Spin it in 3D'; } }, 20000);
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "text", "id": "trust_text", "label": "Trust line", "default": "✓ Lightning fast shipping! · ✓ 30-day returns · ✓ Made 100% in the USA" },
    { "type": "range", "id": "low_stock_threshold", "label": "Low stock warning below", "min": 0, "max": 30, "step": 1, "default": 15 },
    { "type": "checkbox", "id": "show_faq_accordion", "label": "Show info accordions", "default": true }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "question", "label": "Title", "default": "Shipping & returns" },
        { "type": "richtext", "id": "answer", "label": "Content", "default": "<p>Lightning fast shipping! Free US shipping over $40. 30-day returns, no questions.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product page",
      "blocks": [
        { "type": "accordion", "settings": { "question": "Shipping & returns", "answer": "<p>Lightning fast shipping! Free US shipping over $40. 30-day returns, no questions.</p>" } },
        { "type": "accordion", "settings": { "question": "Fit & materials", "answer": "<p>US standard (12\"×6\") and JDM/Euro (520mm × 110mm) sizes. Injection-molded ABS plastic with UV-stable printed graphics. Screws and caps included.</p>" } }
      ]
    }
  ]
}
{% endschema %}
