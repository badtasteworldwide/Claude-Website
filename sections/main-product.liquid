{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign has_frame_3d = false -%}
{%- if product.handle contains 'plate-frame' -%}{%- assign has_frame_3d = true -%}{%- endif -%}
{%- comment -%} Same rule the bundle discount uses: any product with "frame" in its title. {%- endcomment -%}
{%- assign title_lc = product.title | downcase -%}
{%- assign type_lc = product.type | downcase -%}
{%- assign is_frame = false -%}
{%- if title_lc contains 'frame' or type_lc contains 'frame' -%}{%- assign is_frame = true -%}{%- endif -%}
{%- liquid
  comment
    Gallery well follows the photo's own shape (most are 4:3), clamped so an
    odd upload can't make the page jump. Photos are contained, never cropped.
  endcomment
  assign media_ratio = 1.3333
  if product.featured_image
    assign media_ratio = product.featured_image.aspect_ratio
    if media_ratio > 1.6
      assign media_ratio = 1.6
    elsif media_ratio < 0.8
      assign media_ratio = 0.8
    endif
  endif
-%}
<div class="pdp" data-pdp>
  <div class="pdp__grid">
    <div class="pdp__media">
      <div class="pdp__main-img" style="--media-ratio: {{ media_ratio }};" data-gallery-main>
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 1000 }}"
               srcset="{{ product.featured_image | image_url: width: 500 }} 500w, {{ product.featured_image | image_url: width: 750 }} 750w, {{ product.featured_image | image_url: width: 1000 }} 1000w, {{ product.featured_image | image_url: width: 1400 }} 1400w"
               sizes="(max-width: 960px) 100vw, 55vw"
               alt="{{ product.featured_image.alt | default: product.title | escape }}"
               fetchpriority="high" decoding="async"
               width="1000" height="{{ 1000 | divided_by: product.featured_image.aspect_ratio | round }}">
        {%- else -%}
          <div style="width: 80%;">
            {%- render 'plate',
              top: product.metafields.custom.frame_top,
              bottom: product.metafields.custom.frame_bottom,
              number: product.metafields.custom.plate_number,
              color1: product.metafields.custom.plate_color_1,
              color2: product.metafields.custom.plate_color_2 -%}
          </div>
        {%- endif -%}
        {%- if product.images.size > 1 -%}
          <span class="pdp__count" aria-hidden="true"><span data-gallery-index>1</span>/{{ product.images.size | at_most: 8 }}</span>
        {%- endif -%}
        {%- if has_frame_3d -%}
            <button type="button" class="pdp__3d-btn" data-load-3d hidden
              data-css="{{ 'plate-frame-garage.css' | asset_url }}"
              data-js="{{ 'plate-frame-garage.js' | asset_url }}">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 2.5 21 7.5v9L12 21.5 3 16.5v-9z M3 7.5l9 5 9-5 M12 12.5v9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/></svg>
              <span data-3d-label>Spin it in 3D</span>
            </button>
          {%- endif -%}
        {%- if has_frame_3d -%}
          {%- comment -%} 3D slide, filled in by plate-frame-garage.js, which now loads only when the shopper taps "3D". {%- endcomment -%}
          <div class="pfg3d" data-pfg-pdp-lazy hidden
            data-handle="{{ product.handle }}"
            data-catalog="{{ 'pfg-catalog.json' | file_url }}"
            data-thumbs="{{ 'pfg-thumbs.webp' | file_url }}"
            data-model="{{ 'pfg-frame.glb' | file_url }}"
            data-sheet="{{ 'pfg-sheet-00.webp' | file_url }}">
            <canvas aria-label="3D preview of this frame. Drag to rotate."></canvas>
            <span class="pfg3d__loading">Loading 3D…</span>
            <span class="pfg3d__hint">3D · Drag to rotate</span>
            <div class="pfg3d__designs" data-role="designs" role="group" aria-label="Designs" hidden></div>
            <button type="button" class="pfg3d__car" data-role="car" aria-pressed="false" hidden>On a car</button>
            <p class="pfg3d__credit" data-role="credit" hidden>Car: hatchback 3D model used with permission, modified (logos removed, simplified)</p>
          </div>
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="pdp__thumbs">
          {%- if product.images.size > 1 -%}
            {%- for image in product.images limit: 8 -%}
              <button type="button" class="pdp__thumb" data-src="{{ image | image_url: width: 1000 }}" data-active="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="View photo {{ forloop.index }}">
                <img src="{{ image | image_url: width: 160 }}" alt="" loading="lazy" width="160" height="{{ 160 | divided_by: image.aspect_ratio | round }}">
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp__info">
      <h1 class="pdp__title">{{ product.title }}</h1>

      <div class="pdp__price-row">
        <span class="pdp__price" data-price>{{ current_variant.price | money }}</span>
        <span class="pdp__compare" data-compare-price {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
          {%- if current_variant.compare_at_price > current_variant.price -%}{{ current_variant.compare_at_price | money }}{%- endif -%}
        </span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="badge badge--yellow pdp__badge-save">SAVE {{ current_variant.compare_at_price | minus: current_variant.price | money_without_trailing_zeros }}</span>
        {%- endif -%}
        {%- if is_frame -%}<span class="pdp__bundle-hint">3 frames = 10% off · 4+ = 15% off</span>{%- endif -%}
      </div>

      {%- form 'product', product, data-product-form: '', id: 'PdpForm' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          <div data-variant-picker>
            {%- for option in product.options_with_values -%}
              <fieldset class="option-row">
                <legend class="option-label">{{ option.name }}</legend>
                <div class="option-pills{% if option.values.size <= 3 %} option-pills--grid{% endif %}" style="--opt-count: {{ option.values.size | at_most: 3 }};">
                  {%- for value in option.values -%}
                    {%- assign label_main = value | split: ' (' | first -%}
                    {%- assign label_sub = '' -%}
                    {%- if value contains ' (' -%}{%- assign label_sub = value | split: ' (' | last | remove: ')' -%}{%- endif -%}
                    <label class="option-pill">
                      <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}>
                      <span>{{ label_main }}{% if label_sub != blank %}<small>{{ label_sub }}</small>{% endif %}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <div class="pdp__buy">
          <div class="qty-stepper">
            <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
          </div>
          <div class="pdp__atc-row" data-atc-anchor>
            {%- if current_variant.available -%}
              <button type="submit" class="btn btn--lg btn--full" data-atc data-label="Add to cart">Add to cart</button>
            {%- else -%}
              <button type="submit" class="btn btn--lg btn--full" data-atc data-label="Add to cart" disabled>Sold out</button>
            {%- endif -%}
          </div>
        </div>
        {%- if current_variant.inventory_management and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.low_stock_threshold -%}
          <p class="pdp__stock"><span class="product-card__stock">Only {{ current_variant.inventory_quantity }} left</span></p>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.trust_text != blank -%}
        <div class="pdp__trust">{{ section.settings.trust_text }}</div>
      {%- endif -%}

      <div class="pdp__desc rte">{{ product.description }}</div>

      {%- if section.settings.show_faq_accordion -%}
        <div class="faq__list pdp__acc">
          {%- for block in section.blocks -%}
            <details class="faq__item" {{ block.shopify_attributes }}>
              <summary class="faq__q">{{ block.settings.question }}<span class="faq__toggle" aria-hidden="true">+</span></summary>
              <div class="faq__a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Sticky add-to-cart: slides up once the main button scrolls away. Submits the same form. {%- endcomment -%}
  <div class="sticky-atc" data-sticky-atc aria-hidden="true">
    {%- if product.featured_image -%}
      <img class="sticky-atc__img" src="{{ product.featured_image | image_url: width: 160 }}" alt="" width="64" height="{{ 64 | divided_by: product.featured_image.aspect_ratio | round }}" loading="lazy">
    {%- endif -%}
    <div class="sticky-atc__text">
      <strong>{{ product.title | remove: ' License Plate Frame' }}</strong>
      <span><b data-sticky-price>{{ current_variant.price | money }}</b> <span data-sticky-variant>{% unless product.has_only_default_variant %}{{ current_variant.title }}{% endunless %}</span></span>
    </div>
    <button type="button" class="sticky-atc__cart" data-open-cart tabindex="-1" aria-label="Cart, {{ cart.item_count }} items">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M4 8h16l-1.2 12H5.2z" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M8.5 10V6.5a3.5 3.5 0 0 1 7 0V10" fill="none" stroke="currentColor" stroke-width="2.4"/></svg>
      <b data-cart-count>{{ cart.item_count }}</b>
    </button>
    <button type="submit" form="PdpForm" class="btn sticky-atc__btn" data-sticky-btn tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>
  </div>

  <script type="application/json" data-variants-json>
    {{ product.variants | json }}
  </script>
</div>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "text", "id": "trust_text", "label": "Trust line", "default": "✓ Lightning fast shipping! · ✓ 30-day returns · ✓ Made 100% in the USA" },
    { "type": "range", "id": "low_stock_threshold", "label": "Low stock warning below", "min": 0, "max": 30, "step": 1, "default": 15 },
    { "type": "checkbox", "id": "show_faq_accordion", "label": "Show info accordions", "default": true }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "question", "label": "Title", "default": "Shipping & returns" },
        { "type": "richtext", "id": "answer", "label": "Content", "default": "<p>Lightning fast shipping! Free US shipping over $40. 30-day returns, no questions.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product page",
      "blocks": [
        { "type": "accordion", "settings": { "question": "Shipping & returns", "answer": "<p>Lightning fast shipping! Free US shipping over $40. 30-day returns, no questions.</p>" } },
        { "type": "accordion", "settings": { "question": "Fit & materials", "answer": "<p>US standard (12\"×6\") and JDM/Euro (520mm × 110mm) sizes. Injection-molded ABS plastic with UV-stable printed graphics. Screws and caps included.</p>" } }
      ]
    }
  ]
}
{% endschema %}
