<article class="page-shell">
  <div class="section__eyebrow">{{ article.published_at | date: '%b %d, %Y' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</div>
  <h1 class="page-title" style="margin-top: 12px;">{{ article.title }}</h1>
  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="1200" height="675" style="width: 100%; border: 2px solid var(--ink); margin: 24px 0; display: block;">
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
