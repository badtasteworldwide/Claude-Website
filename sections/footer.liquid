<footer class="footer">
  <div class="footer__inner">
    <div class="footer__col">
      {%- if section.settings.brand_image != blank -%}
        <img src="{{ section.settings.brand_image | image_url: width: 320 }}" alt="{{ shop.name | escape }}" class="footer__brand-img" width="160" height="{{ 160 | divided_by: section.settings.brand_image.aspect_ratio | round }}" loading="lazy">
      {%- else -%}
        <div style="font-family: var(--font-display); font-size: 22px; text-transform: uppercase;">{{ shop.name }}</div>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      <div class="footer__social">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram">IG</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok">TT</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook">FB</a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube">YT</a>{%- endif -%}
      </div>
    </div>
    {%- for block in section.blocks -%}
      <div class="footer__col" {{ block.shopify_attributes }}>
        <h4>{{ block.settings.heading }}</h4>
        <ul>
          {%- for link in block.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
  <div class="footer__bottom">
    <div>© {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.location != blank %} · {{ section.settings.location }}{% endif %}</div>
    <nav class="footer__legal" aria-label="Legal">
      {%- for policy in shop.policies -%}
        <a href="{{ policy.url }}">{{ policy.title }}</a>
      {%- endfor -%}
      <a href="/pages/contact">Contact</a>
      <a href="/pages/privacy-choices">Your Privacy Choices</a>
    </nav>
    <div>
      {%- for type in shop.enabled_payment_types -%}
        {{- type | replace: '_', ' ' | upcase -}}{%- unless forloop.last %} · {% endunless -%}
      {%- endfor -%}
    </div>
  </div>
  <p class="footer__disclaimer">Bad Taste Worldwide is an independent company. Brand names referenced belong to their owners; no affiliation or endorsement is implied.</p>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    { "type": "image_picker", "id": "brand_image", "label": "Brand image" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "License plate frames for people who know better and do it anyway. Designed in LA, shipped worldwide." },
    { "type": "text", "id": "location", "label": "Location line", "default": "Los Angeles, CA" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
