<section class="faq" id="faq">
  <div class="section__head" style="margin-bottom: 20px;">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="section__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section__title">{{ section.settings.heading }}</h2>
    </div>
  </div>
  <div class="faq__list">
    {%- for block in section.blocks -%}
      <details class="faq__item" {{ block.shopify_attributes }}>
        <summary class="faq__q">{{ block.settings.question }}<span class="faq__toggle">+</span></summary>
        <div class="faq__a">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Questions <em>with answers.</em></p>" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How fast do you ship?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Lightning fast shipping from Los Angeles, Monday to Friday.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "item", "settings": { "question": "How fast do you ship?", "answer": "<p>Lightning fast shipping from Los Angeles, Monday to Friday. Free US shipping over $40. International takes 7-14 days depending on where you live.</p>" } },
        { "type": "item", "settings": { "question": "Will this fit my car?", "answer": "<p>We make two sizes: US standard (12\"×6\") and JDM/Euro (520mm × 110mm). Filter by size on any product page. Every frame comes with matching screws and screw caps.</p>" } },
        { "type": "item", "settings": { "question": "What's the material?", "answer": "<p>Injection-molded ABS plastic with UV-stable printed graphics. Tested in Arizona sun, Seattle rain, and one guy's Norwegian winter.</p>" } },
        { "type": "item", "settings": { "question": "Can I return it?", "answer": "<p>30 days, no questions. If it arrives broken or we mess up the order, we'll replace it free. If you change your mind, we'll refund you minus return shipping.</p>" } },
        { "type": "item", "settings": { "question": "Is this legal on my plates?", "answer": "<p>US: legal in most states if it doesn't cover the plate number or state name. Check your local laws. We are not your lawyer. We are not even a lawyer.</p>" } }
      ]
    }
  ]
}
{% endschema %}
