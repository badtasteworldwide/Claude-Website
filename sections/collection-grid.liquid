{%- comment -%}
  Collection feed: one full-bleed panel per collection (4:3 cover, never cropped),
  a tilted title sticker, a one-line joke and a shop button. Panels cycle through
  ink, bubblegum and highlighter bands. "Start number" keeps numbering going when
  the feed is split into two sections around another panel.
{%- endcomment -%}
<section class="zfeed" id="{{ section.settings.anchor | default: 'collections' }}">
  {%- if section.settings.heading != blank -%}
    <div class="zfeed__head">
      {%- if section.settings.eyebrow != blank -%}<span class="section__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section__title zfeed__title">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  <div class="zfeed__list">
    {%- assign start = section.settings.start_number | default: 1 -%}
    {%- assign tones = 'ink,pink,yellow' | split: ',' -%}
    {%- for block in section.blocks -%}
      {%- assign coll = block.settings.collection -%}
      {%- assign n = forloop.index0 | plus: start -%}
      {%- assign tone_i = n | minus: 1 | modulo: 3 -%}
      {%- assign flip = n | modulo: 2 -%}
      {%- assign title = block.settings.title_override | default: coll.title | default: 'Pick a collection' -%}
      {%- assign img = block.settings.image -%}
      {%- if img == blank and block.settings.use_image -%}{%- assign img = coll.featured_image -%}{%- endif -%}
      {%- assign joke = block.settings.joke -%}
      {%- if joke == blank and block.settings.frame_top != blank -%}{%- assign joke = block.settings.frame_top | append: '. ' | append: block.settings.frame_bottom -%}{%- endif -%}
      <article class="zpanel zpanel--{{ tones[tone_i] }}{% if flip == 0 %} zpanel--flip{% endif %}" {{ block.shopify_attributes }}>
        <a class="zpanel__media" href="{{ coll.url | default: '#' }}" tabindex="-1" aria-hidden="true" style="--c1: {{ block.settings.color_1 }}; --c2: {{ block.settings.color_2 }};">
          {%- if img != blank -%}
            <img src="{{ img | image_url: width: 900 }}"
                 srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w"
                 sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw"
                 alt="" loading="lazy" decoding="async"
                 width="900" height="{{ 900 | divided_by: img.aspect_ratio | round }}"
                 style="aspect-ratio: {{ img.aspect_ratio }};">
          {%- else -%}
            <span class="zpanel__plate">
              {%- render 'plate', top: block.settings.frame_top, bottom: block.settings.frame_bottom, number: block.settings.plate_number, color1: block.settings.color_1, color2: block.settings.color_2 -%}
            </span>
          {%- endif -%}
          {%- if block.settings.tag != blank -%}<span class="zpanel__tag">{{ block.settings.tag }}</span>{%- endif -%}
        </a>
        <div class="zpanel__body">
          <span class="zpanel__no" aria-hidden="true">No.{% if n < 10 %}0{% endif %}{{ n }}</span>
          <h3 class="zpanel__title"><a href="{{ coll.url | default: '#' }}">{{ title }}</a></h3>
          {%- if joke != blank -%}<p class="zpanel__joke">{{ joke }}</p>{%- endif -%}
          <a class="btn zpanel__cta" href="{{ coll.url | default: '#' }}" aria-label="Shop {{ title | escape }}{% if coll != blank %}, {{ coll.products_count }} frames{% endif %}">
            {%- if coll != blank -%}Shop {{ coll.products_count }} frames{%- else -%}Shop{%- endif -%} <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </article>
    {%- endfor -%}
  </div>
  {%- if section.settings.link_label != blank -%}
    <div class="zfeed__foot">
      <a href="{{ section.settings.link_url | default: routes.collections_url }}" class="section__link">{{ section.settings.link_label }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collections grid",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "06 Collections"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Pick your <em>flavor of bad.</em></p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all collections →"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "collections" },
    { "type": "number", "id": "start_number", "label": "Start number", "default": 1, "info": "Use 4 for a second feed that continues after three panels." },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "uniform",
      "options": [
        {
          "value": "uniform",
          "label": "Uniform grid (all same size)"
        },
        {
          "value": "mosaic",
          "label": "Mosaic (mixed sizes)"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height (uniform layout)",
      "min": 180,
      "max": 400,
      "step": 20,
      "default": 260,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card photo",
          "info": "Shown instead of the plate graphic. Overrides the collection image."
        },
        {
          "type": "select",
          "id": "size",
          "label": "Card size (mosaic layout only)",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Auto pattern"
            },
            {
              "value": "wide",
              "label": "Wide"
            },
            {
              "value": "square",
              "label": "Medium"
            },
            {
              "value": "small",
              "label": "Small"
            }
          ]
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override (optional)"
        },
        { "type": "text", "id": "joke", "label": "One-line joke", "info": "Falls back to the plate frame top and bottom text." },
        {
          "type": "text",
          "id": "tag",
          "label": "Corner tag (e.g. Best Seller)"
        },
        {
          "type": "checkbox",
          "id": "use_image",
          "label": "Use collection image instead of plate",
          "default": false
        },
        {
          "type": "text",
          "id": "frame_top",
          "label": "Plate frame top text"
        },
        {
          "type": "text",
          "id": "frame_bottom",
          "label": "Plate frame bottom text"
        },
        {
          "type": "text",
          "id": "plate_number",
          "label": "Plate number"
        },
        {
          "type": "color",
          "id": "color_1",
          "label": "Card color 1",
          "default": "#fa53c1"
        },
        {
          "type": "color",
          "id": "color_2",
          "label": "Card color 2",
          "default": "#d43ba2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections grid",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "tag": "Best Seller",
            "frame_top": "Konbini at 3AM",
            "frame_bottom": "MIDNIGHT SNACK RUN",
            "plate_number": "JOY·02",
            "color_1": "#e32c2b",
            "color_2": "#b00000"
          }
        },
        {
          "type": "collection",
          "settings": {
            "tag": "Trending",
            "frame_top": "Stan Forever",
            "frame_bottom": "BIAS ON BOARD",
            "plate_number": "BUNNI·5",
            "color_1": "#ff6fb5",
            "color_2": "#ff1f8f"
          }
        },
        {
          "type": "collection",
          "settings": {
            "tag": "Restocked",
            "frame_top": "Track Use Only",
            "frame_bottom": "NO STREET DRIVING",
            "plate_number": "APEX·911",
            "color_1": "#e32c2b",
            "color_2": "#8c0000"
          }
        },
        {
          "type": "collection",
          "settings": {
            "tag": "New",
            "frame_top": "Late Stage Meals",
            "frame_bottom": "VALUE MENU LIFESTYLE",
            "plate_number": "MEAL·99",
            "color_1": "#f4b400",
            "color_2": "#a06600"
          }
        },
        {
          "type": "collection",
          "settings": {
            "frame_top": "Certified Meme Lord",
            "frame_bottom": "STEEL MEMES · SINCE 2001",
            "plate_number": "MEME·420",
            "color_1": "#111111",
            "color_2": "#333333"
          }
        },
        {
          "type": "collection",
          "settings": {
            "frame_top": "Bad Taste Worldwide",
            "frame_bottom": "MADE IN QUESTIONABLE TASTE",
            "plate_number": "BAD·420",
            "color_1": "#fa53c1",
            "color_2": "#d43ba2"
          }
        }
      ]
    }
  ]
}
{% endschema %}
