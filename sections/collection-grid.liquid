<section class="section section--colls" id="collections">
  <div class="section__head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="section__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section__title">{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link_url | default: routes.collections_url }}" class="section__link">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
  {%- assign uniform = false -%}
  {%- if section.settings.layout == 'uniform' or section.settings.layout == blank -%}{%- assign uniform = true -%}{%- endif -%}
  <div class="collections{% if uniform %} collections--uniform{% endif %}" style="--card-h: {{ section.settings.card_height | default: 260 }}px;">
    {%- assign layout_classes = 'collection-card--wide,collection-card--sq,,,,collection-card--wide' | split: ',' -%}
    {%- for block in section.blocks -%}
      {%- assign coll = block.settings.collection -%}
      {%- assign idx = forloop.index0 | modulo: 6 -%}
      {%- assign size_class = '' -%}
      {%- unless uniform -%}
        {%- case block.settings.size -%}
          {%- when 'wide' -%}{%- assign size_class = 'collection-card--wide' -%}
          {%- when 'square' -%}{%- assign size_class = 'collection-card--sq' -%}
          {%- when 'small' -%}{%- assign size_class = '' -%}
          {%- else -%}{%- assign size_class = layout_classes[idx] -%}
        {%- endcase -%}
      {%- endunless -%}
      <a href="{{ coll.url | default: '#' }}" class="collection-card {{ size_class }}" {{ block.shopify_attributes }}>
        <div class="collection-card__media">
        <div class="collection-card__bg" style="background: linear-gradient(135deg, {{ block.settings.color_1 }}, {{ block.settings.color_2 }});">
          {%- assign img = block.settings.image -%}
          {%- assign img_alt = block.settings.title_override -%}
          {%- if img == blank and block.settings.use_image -%}{%- assign img = coll.featured_image -%}{%- assign img_alt = coll.title -%}{%- endif -%}
          {%- if img != blank -%}
            {%- assign img_alt = img.alt | default: img_alt | escape -%}
            {%- if img.aspect_ratio >= 1.8 -%}
              {%- comment -%} 2:1 cover = centred 3:4 poster + blurred padding: crop to the poster, sides show the block colours. {%- endcomment -%}
              <span class="collection-card__poster">
                <img class="collection-card__photo" src="{{ img | image_url: width: 1400 }}" srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 1800 }} 1800w" sizes="(max-width: 768px) 260px, 50vw" alt="{{ img_alt }}" loading="lazy" width="1400" height="{{ 1400 | divided_by: img.aspect_ratio | round }}">
              </span>
            {%- else -%}
              <img class="collection-card__photo" src="{{ img | image_url: width: 900 }}" srcset="{{ img | image_url: width: 300 }} 300w, {{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w" sizes="(max-width: 768px) 130px, 33vw" alt="{{ img_alt }}" loading="lazy" width="900" height="{{ 900 | divided_by: img.aspect_ratio | round }}">
            {%- endif -%}
          {%- else -%}
            <div style="position:absolute; left:50%; top:45%; transform:translate(-50%,-50%); width:70%;">
              {%- render 'plate',
                top: block.settings.frame_top,
                bottom: block.settings.frame_bottom,
                number: block.settings.plate_number,
                color1: block.settings.color_1,
                color2: block.settings.color_2 -%}
            </div>
          {%- endif -%}
        </div>
        </div>
        <div class="collection-card__info">
          {%- if coll != blank -%}
            <div class="collection-card__label">{{ coll.products_count }} frames{%- if block.settings.tag != blank -%}<span class="collection-card__tag">{{ block.settings.tag }}</span>{%- endif -%}</div>
            <div class="collection-card__title">{{ block.settings.title_override | default: coll.title }}</div>
          {%- else -%}
            <div class="collection-card__title">{{ block.settings.title_override | default: 'Pick a collection' }}</div>
          {%- endif -%}
          <div class="collection-card__count">Shop the collection →</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

<style>
  .collections--uniform {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: none;
    grid-auto-rows: auto;
    gap: 28px 24px;
  }
  .collections--uniform .collection-card { grid-column: span 1; grid-row: span 1; }
  /* Photo on top, caption slab below, so the title never covers the cover art.
     Covers are 2:1 with blurred padding around a centred 3:4 poster;
     a 4:3 frame shows the whole poster and trims only padding. */
  .collection-card { display: flex; flex-direction: column; background: var(--paper); }
  .collection-card__media { position: relative; overflow: hidden; aspect-ratio: 4 / 3; flex: none; }
  .collections:not(.collections--uniform) .collection-card__media { aspect-ratio: auto; min-height: 140px; }
  .collection-card__poster {
    position: absolute; top: 0; bottom: 0; left: 50%; transform: translateX(-50%);
    height: 100%; aspect-ratio: 3 / 4; overflow: hidden;
    border-inline: 3px solid var(--ink);
  }
  .collection-card__poster .collection-card__photo { transform: scale(1.03); }
  /* Caption slabs rotate through the colorway: ink, bubblegum, highlighter. */
  .collection-card__info {
    display: grid; grid-template-columns: minmax(0, 1fr); align-items: end; row-gap: 10px;
    padding: 14px 16px 16px; border-top: 3px solid var(--ink); background: var(--ink); color: var(--paper);
    flex: 1 1 auto; align-content: end;
  }
  .collection-card:nth-child(3n+2) .collection-card__info { background: var(--pink-soft); color: var(--ink); }
  .collection-card:nth-child(3n+3) .collection-card__info { background: var(--yellow); color: var(--ink); }
  .collection-card__info .collection-card__tag { position: static; display: inline-block; margin-left: 8px; padding: 2px 6px; font-size: 10px; vertical-align: 1px; }
  .collection-card:nth-child(3n+3) .collection-card__info .collection-card__tag { background: var(--paper); }
  .collection-card__label { grid-column: 1 / -1; margin-bottom: 6px; }
  .collection-card__title { font-size: clamp(17px, 1.6vw, 23px); line-height: 1.1; overflow-wrap: normal; hyphens: none; }
  .collection-card__count { margin-top: 0; justify-self: start; white-space: nowrap; border-bottom: 2px solid currentColor; padding-bottom: 1px; }
  .collection-card:hover .collection-card__count { background: var(--yellow); color: var(--ink); border-color: var(--ink); }
  .collection-card:nth-child(3n+3):hover .collection-card__count { background: var(--paper); }
  /* Phones: a swipeable poster picker instead of a 6-card wall (one screen, not three). */
  @media (max-width: 768px) {
    .section--colls { padding-top: 20px; padding-bottom: 24px; }
    .section--colls .section__head { margin-bottom: 12px; align-items: center; flex-wrap: nowrap; }
    .section--colls .section__eyebrow { display: none; }
    .section--colls .section__title { font-size: 20px; max-width: none; }
    .section--colls .section__link { white-space: nowrap; padding: 10px 10px; font-size: 11px; min-height: 44px; display: inline-flex; align-items: center; }
    .collections--uniform {
      display: flex; gap: 10px; overflow-x: auto; overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter);
      margin: 0 calc(var(--gutter) * -1); padding: 2px var(--gutter) 8px;
      scrollbar-width: none;
    }
    .collections--uniform::-webkit-scrollbar { display: none; }
    .collections--uniform .collection-card {
      flex: 0 0 116px; scroll-snap-align: start; box-shadow: var(--shadow-sm); border-width: 2px; aspect-ratio: auto;
    }
    .collections--uniform .collection-card:hover { transform: none; box-shadow: var(--shadow-sm); }
    .collections--uniform .collection-card__media { aspect-ratio: 3 / 4; }
    .collections--uniform .collection-card__poster { left: 0; transform: none; width: 100%; border-inline: 0; }
    .collections--uniform .collection-card__poster .collection-card__photo { transform: none; }
    .collections--uniform .collection-card__info { padding: 7px 8px 8px; row-gap: 0; border-top-width: 2px; }
    .collections--uniform .collection-card__label { display: none; }
    .collections--uniform .collection-card__title { font-size: 12px; line-height: 1.15; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.3em; }
    .collections--uniform .collection-card__count { display: none; }
  }
</style>

{% schema %}
{
  "name": "Collections grid",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "06 Collections"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Pick your <em>flavor of bad.</em></p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all collections →"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "uniform",
      "options": [
        {
          "value": "uniform",
          "label": "Uniform grid (all same size)"
        },
        {
          "value": "mosaic",
          "label": "Mosaic (mixed sizes)"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height (uniform layout)",
      "min": 180,
      "max": 400,
      "step": 20,
      "default": 260,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card photo",
          "info": "Shown instead of the plate graphic. Overrides the collection image."
        },
        {
          "type": "select",
          "id": "size",
          "label": "Card size (mosaic layout only)",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Auto pattern"
            },
            {
              "value": "wide",
              "label": "Wide"
            },
            {
              "value": "square",
              "label": "Medium"
            },
            {
              "value": "small",
              "label": "Small"
            }
          ]
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override (optional)"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Corner tag (e.g. Best Seller)"
        },
        {
          "type": "checkbox",
          "id": "use_image",
          "label": "Use collection image instead of plate",
          "default": false
        },
        {
          "type": "text",
          "id": "frame_top",
          "label": "Plate frame top text"
        },
        {
          "type": "text",
          "id": "frame_bottom",
          "label": "Plate frame bottom text"
        },
        {
          "type": "text",
          "id": "plate_number",
          "label": "Plate number"
        },
        {
          "type": "color",
          "id": "color_1",
          "label": "Card color 1",
          "default": "#fa53c1"
        },
        {
          "type": "color",
          "id": "color_2",
          "label": "Card color 2",
          "default": "#d43ba2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections grid",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "tag": "Best Seller",
            "frame_top": "Konbini at 3AM",
