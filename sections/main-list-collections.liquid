<div class="coll-hero">
  <div class="coll-hero__inner">
    <span class="section__eyebrow">{{ collections.size }} Collections</span>
    <h1 class="coll-hero__title">{{ section.settings.heading | default: 'Every flavor of bad.' }}</h1>
  </div>
</div>

<div class="coll-grid-wrap">
  {%- paginate collections by 24 -%}
    <div class="collections" style="grid-template-rows: none; grid-auto-rows: 220px;">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-card collection-card--sq">
          <div class="collection-card__bg" style="background: linear-gradient(135deg, var(--pink), var(--pink-deep));">
            {%- if collection.featured_image -%}
              <img class="collection-card__photo" src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="600" height="600" style="width:100%; height:100%; object-fit:cover;">
            {%- endif -%}
          </div>
          <div class="collection-card__overlay">
            <div class="collection-card__title">{{ collection.title }}</div>
            <div class="collection-card__count">{{ collection.products_count }} frames</div>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" role="navigation" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn--sm btn--paper">← Prev</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--sm btn--paper">Next →</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every flavor of bad." }
  ]
}
{% endschema %}
