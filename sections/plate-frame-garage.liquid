{%- comment -%}
  Plate Frame Garage: 3D viewer for every Bad Taste license plate frame.
  Assets live in Content > Files (pfg-*.webp / .glb / .json, uploaded by
  plate-frames/tools/shopify_pack.py); the script is assets/plate-frame-garage.js.
{%- endcomment -%}
{{ 'plate-frame-garage.css' | asset_url | stylesheet_tag }}

<div
  class="pfg{% if section.settings.dark %} pfg--dark{% endif %}"
  data-pfg
  data-catalog="{{ 'pfg-catalog-3.json' | file_url }}"
  data-popular="{% render 'pfg-popular', collection: section.settings.popular %}"
  data-thumbs="{{ 'pfg-thumbs-3.webp' | file_url }}"
  data-model="{{ 'pfg-frame.glb' | file_url }}"
  data-sheet="{{ 'pfg-sheet-00.webp' | file_url }}"
  data-products="{{ routes.root_url | append: '/products/' | replace: '//', '/' }}"
  style="--pfg-accent: {{ section.settings.accent }}; --pfg-height: {{ section.settings.height }}vh;"
>
  <aside class="pfg-rail" aria-label="Plate frame designs">
    <header class="pfg-brand">
      {%- if section.settings.eyebrow != blank -%}<small>{{ section.settings.eyebrow }}</small>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </header>
    <label class="pfg-search">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" data-role="q" placeholder="Search designs…" autocomplete="off" aria-label="Search designs">
    </label>
    <div class="pfg-filter" role="group" aria-label="Which designs to show">
      <button type="button" class="pfg-btn" data-filter="current" aria-pressed="true">In store <span class="pfg-n" data-count="current"></span></button>
      <button type="button" class="pfg-btn" data-filter="all" aria-pressed="false">All designs <span class="pfg-n" data-count="all"></span></button>
    </div>
    <nav class="pfg-list" data-role="list"></nav>
  </aside>

  <div class="pfg-bay">
    <canvas data-role="stage" aria-label="3D preview of the selected plate frame. Drag to rotate, scroll or pinch to zoom."></canvas>
    <div class="pfg-loading" data-role="loading">Loading 3D preview…</div>
    <div class="pfg-plaque" aria-live="polite">
      <span class="pfg-eyebrow" data-role="eyebrow"></span>
      <h3 data-role="name"></h3>
      <a class="pfg-shop" data-role="shop" href="#" hidden>Shop this frame <span aria-hidden="true">→</span></a>
    </div>
    <div class="pfg-dock" role="toolbar" aria-label="Viewer controls">
      <button type="button" class="pfg-btn pfg-icon" data-role="prev" aria-label="Previous design"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m15 18-6-6 6-6"/></svg></button>
      <button type="button" class="pfg-btn" data-role="plate" aria-pressed="true">Plate</button>
      <button type="button" class="pfg-btn" data-role="car" aria-pressed="false" title="Show the frame mounted on a car">Car</button>
      <button type="button" class="pfg-btn" data-role="spin" aria-pressed="false">Turntable</button>
      <button type="button" class="pfg-btn" data-role="reset">Reset</button>
      <button type="button" class="pfg-btn pfg-icon" data-role="next" aria-label="Next design"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 18 6-6-6-6"/></svg></button>
    </div>
  </div>
</div>

<script type="module" src="{{ 'plate-frame-garage.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Plate Frame Garage",
  "tag": "section",
  "class": "section-plate-frame-garage",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Bad Taste Worldwide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Plate Frame Garage" },
    { "type": "range", "id": "height", "label": "Height (desktop)", "min": 60, "max": 100, "step": 5, "unit": "vh", "default": 85 },
    { "type": "color", "id": "accent", "label": "Accent colour", "default": "#d81b6d" },
    { "type": "checkbox", "id": "dark", "label": "Dark showroom", "default": true },
    { "type": "collection", "id": "popular", "label": "Best-seller order", "info": "A collection sorted Best selling that holds every frame. The viewer opens on its top seller. Leave empty for Labor Day Sale — Plate Frames." }
  ],
  "presets": [{ "name": "Plate Frame Garage" }]
}
{% endschema %}
