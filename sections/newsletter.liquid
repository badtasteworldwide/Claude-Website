<section class="newsletter">
  <h2 class="newsletter__title">{{ section.settings.heading }}</h2>
  {%- if section.settings.subheading != blank -%}<p class="newsletter__sub">{{ section.settings.subheading }}</p>{%- endif -%}
  {%- form 'customer', class: 'newsletter__form', id: 'newsletter-form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label for="newsletter-email" class="visually-hidden" style="position:absolute; left:-9999px;">Email</label>
    <input id="newsletter-email" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: 'you@badtaste.com' }}" required autocomplete="email">
    <button class="btn btn--ink" type="submit">{{ section.settings.button_label }}</button>
  {%- endform -%}
  {%- form 'customer' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-msg form-msg--ok">You're in. Check your email.</p>
    {%- elsif form.errors -%}
      <p class="form-msg form-msg--err">{{ form.errors.messages.email }}</p>
    {%- endif -%}
  {%- endform -%}
  {%- if section.settings.fine_print != blank -%}
    <p style="margin-top:16px; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; letter-spacing:0.1em; opacity:.8;">{{ section.settings.fine_print }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Get bad taste<br>in your inbox.</p>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Early access to new drops. No spam." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "you@badtaste.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign Me Up" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
