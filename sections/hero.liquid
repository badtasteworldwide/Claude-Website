{%- liquid
  assign rail = section.settings.rail_collection
  if rail == blank
    assign rail = collections.all
  endif
  assign shop_url = section.settings.cta1_link | default: routes.all_products_collection_url
-%}
<section class="hero hero--shop" data-hero>
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="hero__cta-row">
        {%- if section.settings.cta1_label != blank -%}
          <a href="{{ shop_url }}" class="btn btn--lg">{{ section.settings.cta1_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_link | default: '#collections' }}" class="btn btn--lg btn--paper">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="hero-rail">
      <div class="hero-rail__head">
        <h2 class="hero-rail__label">{{ section.settings.rail_label | default: 'Best sellers' }}</h2>
        <a class="hero-rail__link" href="{{ rail.url | default: shop_url }}">{{ section.settings.rail_link_label | default: 'Shop all' }} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="hero-rail__track" role="list">
        {%- for product in rail.products limit: section.settings.rail_limit -%}
          <li class="hero-rail__slide">
            {%- liquid
              assign eager = false
              if forloop.index <= 2
                assign eager = true
              endif
            -%}
            {%- render 'product-card', card_product: product, eager: eager, sizes: '(max-width: 600px) 72vw, (max-width: 960px) 40vw, 22vw' -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "collection", "id": "rail_collection", "label": "Best-seller rail collection", "info": "Real product photos shown in the first screen." },
    { "type": "range", "id": "rail_limit", "label": "Products in the rail", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "rail_label", "label": "Rail label", "default": "Best sellers" },
    { "type": "text", "id": "rail_link_label", "label": "Rail link label", "default": "Shop all" },
    { "type": "select", "id": "visual", "label": "Legacy card (unused)", "options": [{ "value": "photo", "label": "Collection photos" }, { "value": "garage", "label": "3D frame configurator" }], "default": "photo" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Small-batch drops · Lightning fast shipping!"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Tastes so <em>bad</em> it's good.</p>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "License plate frames for K-pop stans, 3AM konbini runs, degenerate meme lords, track addicts, and everyone whose mom would hate their Lexus. Small-batch drops. Heavy plastic. No apologies."
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Primary button label",
      "default": "Shop The Drop →"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label",
      "default": "Browse Collections"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero photo",
      "info": "Default hero photo. Collection buttons below swap it for each collection image."
    },
    {
      "type": "text",
      "id": "sticker_text",
      "label": "Sticker text",
      "default": "NEW DROP"
    },
    {
      "type": "text",
      "id": "sticker_small",
      "label": "Sticker small text",
      "default": "12 THEMES"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Ships From LA"
        }
      ]
    },
    {
      "type": "theme_chip",
      "name": "Collection button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Bad Taste"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Button links here and shows this collection's image in the hero."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product image (optional)",
          "info": "Shows this product's photo instead of the collection image. Links to the product if no collection is set."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional)",
          "info": "Overrides the collection image when this button is selected."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "3,300+",
            "label": "Orders Shipped"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "160",
            "label": "Frame Designs"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "⚡",
            "label": "Lightning Fast Shipping!"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "$40+",
            "label": "Free Shipping"
          }
        },
        {
          "type": "theme_chip",
          "settings": {
            "label": "Bad Taste"
          }
        },
        {
          "type": "theme_chip",
          "settings": {
            "label": "Konbini"
          }
        },
        {
          "type": "theme_chip",
          "settings": {
            "label": "K-Pop"
          }
        },
        {
          "type": "theme_chip",
          "settings": {
            "label": "Track"
          }
        }
      ]
    }
  ]
}
{% endschema %}
