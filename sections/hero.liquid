{%- comment -%}
  Feed-style hero: slogan, one line of copy, then a swipeable rail of real frames
  so the first screen on a phone shows product and prices, not a wall of text.
{%- endcomment -%}
{%- assign rail = section.settings.rail_collection -%}
<section class="zhero" data-hero>
  <div class="zhero__copy">
    {%- if section.settings.eyebrow != blank -%}
      <div class="zhero__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h1 class="zhero__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="zhero__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="zhero__rail-wrap">
    {%- if section.settings.sticker_text != blank -%}
      <div class="zhero__sticker" aria-hidden="true">{{ section.settings.sticker_text }}{% if section.settings.sticker_small != blank %}<small>{{ section.settings.sticker_small }}</small>{% endif %}</div>
    {%- endif -%}
    <ul class="zhero__rail" aria-label="{{ section.settings.rail_label | escape }}">
      {%- if rail != blank -%}
        {%- for product in rail.products limit: section.settings.rail_limit -%}
          {%- assign img = product.featured_image -%}
          <li class="rcard">
            <a href="{{ product.url }}" class="rcard__link">
              <span class="rcard__img">
                {%- if img -%}
                  <img src="{{ img | image_url: width: 600 }}"
                       srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w"
                       sizes="(max-width: 600px) 76vw, 340px"
                       alt="{{ img.alt | default: product.title | escape }}"
                       width="600" height="{{ 600 | divided_by: img.aspect_ratio | round }}"
                       {% if forloop.index <= 2 %}{% if forloop.first %}fetchpriority="high"{% endif %}{% else %}loading="lazy"{% endif %} decoding="async">
                {%- endif -%}
              </span>
              <span class="rcard__meta">
                <span class="rcard__name">{{ product.title | remove: ' License Plate Frame' | remove: ' license plate frame' }}</span>
                <span class="rcard__price">{{ product.price | money }}</span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
      <li class="rcard rcard--more">
        <a href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}" class="rcard__link">
          <span class="rcard__more-big">Still<br>swiping?<br>Respect.</span>
          <span class="rcard__more-cta">{{ section.settings.cta1_label }}</span>
        </a>
      </li>
    </ul>
  </div>

  <div class="zhero__cta">
    {%- if section.settings.cta1_label != blank -%}
      <a href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}" class="btn btn--lg zhero__cta-main">{{ section.settings.cta1_label }}</a>
    {%- endif -%}
    {%- if section.settings.cta2_label != blank -%}
      <a href="{{ section.settings.cta2_link | default: '#collections' }}" class="zhero__cta-alt">{{ section.settings.cta2_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "collection", "id": "rail_collection", "label": "Swipe rail products", "info": "Real frames shown right under the slogan." },
    { "type": "range", "id": "rail_limit", "label": "Products in the rail", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "rail_label", "label": "Rail label (screen readers)", "default": "Best sellers" },
    { "type": "select", "id": "visual", "label": "Legacy visual (unused)", "options": [{ "value": "photo", "label": "Collection photos" }, { "value": "garage", "label": "3D frame configurator" }], "default": "photo" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Small-batch drops · Lightning fast shipping!"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Tastes so <em>bad</em> it's good.</p>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "License plate frames for K-pop stans, 3AM konbini runs, degenerate meme lords, track addicts, and everyone whose mom would hate their Lexus. Small-batch drops. Heavy plastic. No apologies."
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Primary button label",
      "default": "Shop The Drop →"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label",
      "default": "Browse Collections"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero photo",
      "info": "Default hero photo. Collection buttons below swap it for each collection image."
    },
    {
      "type": "text",
      "id": "sticker_text",
      "label": "Sticker text",
      "default": "NEW DROP"
    },
    {
      "type": "text",
      "id": "sticker_small",
      "label": "Sticker small text",
      "default": "12 THEMES"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Ships From LA"
        }
      ]
    },
    {
      "type": "theme_chip",
      "name": "Collection button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Bad Taste"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Button links here and shows this collection's image in the hero."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product image (optional)",
          "info": "Shows this product's photo instead of the collection image. Links to the product if no collection is set."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional)",
          "info": "Overrides the collection image when this button is selected."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "3,300+",
            "label": "Orders Shipped"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "160",
            "label": "Frame Designs"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "⚡",
            "label": "Lightning Fast Shipping!"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "$40+",
            "label": "Free Shipping"
          }
        },
        {
          "type": "theme_chip",
          "settings": {
            "label": "Bad Taste"
          }
        },
        {
          "type": "theme_chip",
          "settings": {
            "label": "Konbini"
          }
        },
        {
          "type": "theme_chip",
          "settings": {
            "label": "K-Pop"
          }
        },
        {
          "type": "theme_chip",
          "settings": {
            "label": "Track"
          }
        }
      ]
    }
  ]
}
{% endschema %}
