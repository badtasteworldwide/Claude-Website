<section class="hero" data-hero>
  <div class="hero__grid">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <div class="hero__eyebrow"><span class="blip"></span> {{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub{% if section.settings.subheading_mobile != blank %} hero__sub--long{% endif %}">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.subheading_mobile != blank -%}
        <p class="hero__sub hero__sub--short">{{ section.settings.subheading_mobile }}</p>
      {%- endif -%}
      {%- comment -%} Phone only: thumb-friendly flavor chips + the 3D entry point, in place of the big visual card. {%- endcomment -%}
      <div class="hero__rail" role="list" aria-label="Shop by flavor">
        {%- if section.settings.visual == 'garage' -%}
          <span role="listitem"><button type="button" class="hero__chip hero__chip--3d" data-garage-open aria-haspopup="dialog" aria-controls="heroGarage">
            <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M225.6,62.64l-88-48.17a19.91,19.91,0,0,0-19.2,0l-88,48.17A20,20,0,0,0,20,80.19v95.62a20,20,0,0,0,10.4,17.55l88,48.17a19.89,19.89,0,0,0,19.2,0l88-48.17A20,20,0,0,0,236,175.81V80.19A20,20,0,0,0,225.6,62.64ZM128,36.57,200,76,128,115.4,56,76ZM44,96.79l72,39.4v76.67L44,173.44Zm96,116.07V136.19l72-39.4v76.65Z"/></svg>
            Spin it in 3D</button></span>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'theme_chip' -%}
            {%- assign chip_url = block.settings.collection.url | default: block.settings.product.url -%}
            {%- if chip_url -%}
              <span role="listitem"><a class="hero__chip" href="{{ chip_url }}">{{ block.settings.label }}</a></span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="hero__cta-row">
        {%- if section.settings.cta1_label != blank -%}
          <a href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}" class="btn btn--lg">{{ section.settings.cta1_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_link | default: '#collections' }}" class="btn btn--lg btn--paper">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
      <div class="hero__meta">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="hero__meta-item" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- liquid
      assign hero_fit = 'photo'
      if section.settings.image != blank
        if section.settings.image.aspect_ratio >= 1.8
          assign hero_fit = 'banner'
        elsif section.settings.image.aspect_ratio < 1
          assign hero_fit = 'portrait'
        endif
      endif
    -%}
    {%- if section.settings.visual == 'garage' -%}
    <div class="hero__visual hero__visual--3d" id="heroGarage" data-garage-card aria-label="3D frame viewer">
      <button type="button" class="hero__garage-close" data-garage-close aria-label="Close 3D viewer"><svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M208.49,191.51a12,12,0,0,1-17,17L128,145,64.49,208.49a12,12,0,0,1-17-17L111,128,47.51,64.49a12,12,0,0,1,17-17L128,111l63.51-63.52a12,12,0,0,1,17,17L145,128Z"/></svg><span>Close</span></button>
      {%- render 'hero-garage' -%}
    </div>
    {%- else -%}
    <div class="hero__visual" data-fit="{{ hero_fit }}">
      {%- if section.settings.image != blank -%}
        <img class="hero__backdrop" data-hero-backdrop src="{{ section.settings.image | image_url: width: 600 }}" alt="" aria-hidden="true" width="600" height="600">
        <div class="hero__photo-wrap">
        <img class="hero__photo" data-hero-photo
             src="{{ section.settings.image | image_url: width: 1200 }}"
             srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
             sizes="(max-width: 960px) 100vw, 50vw"
             alt="{{ section.settings.image.alt | default: shop.name | escape }}"
             width="1200" height="{{ 1200 | divided_by: section.settings.image.aspect_ratio | round }}" fetchpriority="high">
        </div>
      {%- else -%}
        <div class="hero__bg-stripes"></div>
        <div class="hero__car"><div class="hero__car-bg"></div></div>
        <img class="hero__backdrop" data-hero-backdrop alt="" aria-hidden="true" width="600" height="600" hidden>
        <div class="hero__photo-wrap">
          <img class="hero__photo" data-hero-photo alt="" width="1200" height="600" hidden>
        </div>
      {%- endif -%}
      {%- if section.settings.sticker_text != blank -%}
        <div class="hero__sticker">{{ section.settings.sticker_text }}{% if section.settings.sticker_small != blank %}<small>{{ section.settings.sticker_small }}</small>{% endif %}</div>
      {%- endif -%}
      <a data-hero-cta href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}" class="btn hero__shop-btn">Shop all frames →</a>
      {%- assign has_chips = false -%}
      {%- for block in section.blocks -%}{%- if block.type == 'theme_chip' -%}{%- assign has_chips = true -%}{%- endif -%}{%- endfor -%}
      {%- if has_chips -%}
        <div class="theme-switcher">
          {%- for block in section.blocks -%}
            {%- if block.type == 'theme_chip' -%}
              {%- assign chip_coll = block.settings.collection -%}
              {%- assign chip_prod = block.settings.product -%}
              {%- assign chip_img = block.settings.image | default: chip_prod.featured_image | default: chip_coll.featured_image -%}
              {%- assign chip_url = chip_coll.url | default: chip_prod.url -%}
              <button type="button" class="hero-chip" {{ block.shopify_attributes }}
                data-active="false" aria-pressed="false"
                data-label="{{ block.settings.label | escape }}"
                {% if chip_url %}data-url="{{ chip_url }}"{% endif %}
                {% if chip_img %}data-image="{{ chip_img | image_url: width: 1600 }}" data-aspect="{{ chip_img.aspect_ratio }}"{% endif %}>{{ block.settings.label }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>

<style>
  .hero-chip {
    font-family: var(--font-label); font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.02em;
    padding: 8px 10px; min-height: 40px; border: 2px solid var(--ink);
    background: var(--paper); cursor: pointer; transition: background .12s;
    white-space: nowrap;
  }
  .hero-chip:hover { background: var(--yellow); }
  .hero-chip[data-active="true"] { background: var(--ink); color: var(--paper); }
  .hero-chip:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
  .hero__shop-btn { position: absolute; left: 16px; bottom: 84px; z-index: 9; }
  @media (max-width: 600px) { .hero__shop-btn { bottom: 120px; padding: 10px 16px; font-size: 12px; } }
</style>
<script>
  (function () {
    var hero = document.currentScript.previousElementSibling;
    while (hero && !hero.hasAttribute('data-hero')) hero = hero.previousElementSibling;
    if (!hero) hero = document.querySelector('[data-hero]');
    if (!hero) return;
    var chips = Array.prototype.slice.call(hero.querySelectorAll('.hero-chip'));
    if (!chips.length) return;
    var img = hero.querySelector('[data-hero-photo]');
    var backdrop = hero.querySelector('[data-hero-backdrop]');
    var cta = hero.querySelector('[data-hero-cta]');
    // Warm the cache so switching is instant.
    chips.forEach(function (c) { if (c.dataset.image) { var i = new Image(); i.src = c.dataset.image; } });
    var swapToken = 0;
    function activate(chip) {
      chips.forEach(function (c) {
        var on = c === chip;
        c.dataset.active = String(on);
        c.setAttribute('aria-pressed', String(on));
      });
      if (img && chip.dataset.image) {
        img.style.opacity = '0';
        // Swap only once the new photo is decoded, and only if no newer chip was clicked meanwhile.
        var my = ++swapToken;
        var pre = new Image();
        pre.src = chip.dataset.image;
        var ready = Promise.race([
          pre.decode ? pre.decode().catch(function () {}) : Promise.resolve(),
          new Promise(function (r) { setTimeout(r, 2500); }) // don't stay blank on a stalled request
        ]);
        var faded = new Promise(function (r) { setTimeout(r, 180); });
        Promise.all([ready, faded]).then(function () {
          if (my !== swapToken) return;
          img.src = chip.dataset.image;
          img.removeAttribute('srcset');
          img.alt = chip.dataset.label || '';
          img.hidden = false;
          img.style.opacity = '1';
          // One-shot zoom-in on change (CSS skips it for reduced motion).
          img.classList.remove('is-zooming'); void img.offsetWidth; img.classList.add('is-zooming');
          if (backdrop) { backdrop.src = chip.dataset.image; backdrop.hidden = false; }
          var a = parseFloat(chip.dataset.aspect) || 1;
          hero.querySelector('.hero__visual').dataset.fit = a >= 1.8 ? 'banner' : (a < 1 ? 'portrait' : 'photo');
        });
      }
      if (cta && chip.dataset.url) {
        cta.href = chip.dataset.url;
        cta.textContent = 'Shop ' + (chip.dataset.label || 'the collection') + ' \u2192';
      }
    }
    chips.forEach(function (chip) {
      // First click previews the collection; clicking the selected chip again opens it.
      chip.addEventListener('click', function () {
        if (chip.dataset.url && (chip.dataset.active === 'true' || !chip.dataset.image)) {
          window.location.href = chip.dataset.url;
          return;
        }
        activate(chip);
      });
    });
  })();
</script>

<script>
  /* Phone: the 3D card is an opt-in full-screen viewer. three.js (~600KB) is only
     fetched when the shopper taps "Spin it in 3D" (see snippets/hero-garage). */
  (function () {
    var card = document.querySelector('[data-garage-card]');
    var opener = document.querySelector('[data-garage-open]');
    if (!card || !opener) return;
    var closer = card.querySelector('[data-garage-close]');
    function open() {
      card.dataset.open = 'true';
      card.setAttribute('role', 'dialog');
      card.setAttribute('aria-modal', 'true');
      document.documentElement.classList.add('is-locked');
      if (window.BTWloadGarage) window.BTWloadGarage();
      closer.focus();
    }
    function close() {
      card.dataset.open = 'false';
      card.removeAttribute('role');
      card.removeAttribute('aria-modal');
      document.documentElement.classList.remove('is-locked');
      opener.focus();
    }
    opener.addEventListener('click', open);
    closer.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && card.dataset.open === 'true') close();
    });
  })();
</script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "select", "id": "visual", "label": "Right-hand card", "options": [{ "value": "photo", "label": "Collection photos" }, { "value": "garage", "label": "3D frame configurator" }], "default": "photo" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Small-batch drops · Lightning fast shipping!"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Tastes so <em>bad</em> it's good.</p>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "License plate frames for K-pop stans, 3AM konbini runs, degenerate meme lords, track addicts, and everyone whose mom would hate their Lexus. Small-batch drops. Heavy plastic. No apologies."
    },
    {
      "type": "text",
      "id": "subheading_mobile",
      "label": "Short subheading (phones)",
      "info": "Shown instead of the subheading on small screens. Leave empty to use the full subheading.",
      "default": "License plate frames for K-pop stans, 3AM konbini runs, meme lords and track addicts."
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Primary button label",
      "default": "Shop The Drop →"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label",
      "default": "Browse Collections"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero photo",
      "info": "Default hero photo. Collection buttons below swap it for each collection image."
    },
    {
      "type": "text",
      "id": "sticker_text",
      "label": "Sticker text",
      "default": "NEW DROP"
    },
    {
      "type": "text",
      "id": "sticker_small",
      "label": "Sticker small text",
      "default": "12 THEMES"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Ships From LA"
        }
      ]
    },
    {
      "type": "theme_chip",
      "name": "Collection button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Bad Taste"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Button links here and shows this collection's image in the hero."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product image (optional)",
          "info": "Shows this product's photo instead of the collection image. Links to the product if no collection is set."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional)",
          "info": "Overrides the collection image when this button is selected."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "3,300+",
            "label": "Orders Shipped"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "160",
            "label": "Frame Designs"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "⚡",
            "label": "Lightning Fast Shipping!"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "$40+",
            "label": "Free Shipping"
          }
        },
        {
          "type": "theme_chip",
          "settings": {
            "label": "Bad Taste"
          }
        },
        {
          "type": "theme_chip",
          "settings": {
            "label": "Konbini"
          }
        },
        {
