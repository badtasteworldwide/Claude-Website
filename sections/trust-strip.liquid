{%- if section.blocks.size > 0 -%}
<div class="trust-strip">
  <div class="trust-strip__track" data-marquee>
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.text }}<span class="star">★</span></span>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Trust strip",
  "max_blocks": 10,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "FREE SHIP $40+" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "item", "settings": { "text": "3,300+ ORDERS SHIPPED" } },
        { "type": "item", "settings": { "text": "FREE SHIP $40+" } },
        { "type": "item", "settings": { "text": "24HR FROM LA" } },
        { "type": "item", "settings": { "text": "30-DAY RETURNS" } },
        { "type": "item", "settings": { "text": "SHIPS WORLDWIDE" } },
        { "type": "item", "settings": { "text": "PAY IN 4 · AFTERPAY" } }
      ]
    }
  ]
}
{% endschema %}
