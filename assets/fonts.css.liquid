/* Bad Taste Worldwide: self-hosted Google Fonts (SIL Open Font License).
   Display: Dela Gothic One (single heavy weight; the face covers 100-900 so
   bold text never gets a faux-bold smear). Text: Archivo variable (wght 100-900,
   wdth 62-125). "Archivo Wide" is the same file pinned to an expanded width
   for labels, prices and nav: the racing-decal voice of the brand. */
@font-face {
  font-family: 'Dela Gothic One';
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url("{{ 'dela-gothic-one-latin.woff2' | asset_url }}") format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Dela Gothic One';
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url("{{ 'dela-gothic-one-latin-ext.woff2' | asset_url }}") format('woff2');
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
@font-face {
  font-family: 'Archivo';
  font-style: normal;
  font-weight: 100 900;
  font-stretch: 62% 125%;
  font-display: swap;
  src: url("{{ 'archivo-var-latin.woff2' | asset_url }}") format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Archivo';
  font-style: normal;
  font-weight: 100 900;
